# Local run artifacts (test logs, telemetry). Never tracked.
/artifacts/

# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Local-only GPU load telemetry; acceptance evidence remains tracked separately.

# devenv generates this per-machine; it is never reproducible from the flake.
.devenv/
.devenv.flake.nix

# Ignore automatically generated direnv output
.direnv

# `.agents/` is machine-local: the devman central overlay owns it (a symlink
# to ~/.config/devman/projects/<p>/agents). Nothing under it is tracked — the
# router is generated by `repoman install-skills` and the pool skills are links.
# AGENTS.md and CLAUDE.md stay committed by design.
.agents
