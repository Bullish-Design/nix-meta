# Local run artifacts (test logs, telemetry). Never tracked.
/artifacts/

# Local provider credentials. Never track API keys.
.env

# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Local-only GPU load telemetry; acceptance evidence remains tracked separately.

# devenv generates this per-machine; it is never reproducible from the flake.
.devenv/
.devenv.flake.nix

# Ignore automatically generated direnv output
.direnv

# Repository agent surfaces are machine-local links owned by the devman overlay.
# `.agents` is the compatibility alias for `.claude`. Nothing under either path
# is tracked. AGENTS.md and CLAUDE.md stay committed by design.
.claude
.agents
.testee/
